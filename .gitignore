# ── Local environment & artifact hygiene (narrowly scoped) ───────────────
# Local Python virtual environments. `venv/` is already covered above;
# `.venv*/` additionally matches .venv-1, .venv-2 and .venv-repair.
# NOTE: scripts/qa_header_transition.py and scripts/qa_nav_browser.py are
# documented to run via `.venv-2/bin/python` — the directory stays on disk.
.venv*/

# Accidental lockfile generated by an npm run at the repo root.
# Leading slash anchors to root, so frontend/package-lock.json stays tracked.
/package-lock.json

# Generated Lighthouse reports (local only).
/frontend/lh-report*.json

# Local source backup and one-off utility script (kept on disk, not tracked).
/frontend/src/App.original.jsx
/frontend/src/fix_glass_tokens.py

# Local settings backups (exact paths; live settings.py stays tracked).
/hotel_project/settings.py.before-csrf-fix
/hotel_project/settings.py.csrf-backup
# Environment secrets
.env
.env.*
!.env.example

