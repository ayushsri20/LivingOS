# ===========================================
# Production Environment Variables Template
# ===========================================
# Copy this file and rename to .env for local development
# For production (Render/Heroku), set these as environment variables in your dashboard

# Security Settings (REQUIRED FOR PRODUCTION)
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts - comma separated list of your domains
ALLOWED_HOSTS=panesar-pg.onrender.com,localhost,127.0.0.1

# Database URL (Supabase PostgreSQL for production)
# Supabase → Project Settings → Database → URI
# Use the *session* pooler connection string on a free tier.
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave unset locally to fall back to SQLite (db.sqlite3).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Deployed frontend origin(s), comma separated. Required in production so the
# browser will accept API responses from the Vercel domain.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Trust the frontend origins for CSRF-protected POSTs (login/logout).
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Cross-site cookies. Leave as None for Vercel + Render; set to Lax only if the
# frontend and API are served from the same site.
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Optional: Django log level
DJANGO_LOG_LEVEL=INFO
