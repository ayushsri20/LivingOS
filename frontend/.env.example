# Frontend environment variables (Vite)
#
# Copy to `frontend/.env.local` for local development. `.env*` files are
# gitignored — never commit real values.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Leave unset locally so the API client calls the same origin (the Vite dev
# server proxies /api to Django on port 8000).
#
# In production (Vercel) set this to the deployed Render backend URL, e.g.
# VITE_API_BASE_URL=https://panesar-pg.onrender.com

VITE_API_BASE_URL=